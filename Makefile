docs/user_doc/config.puml:	src/models/config.py ## Generate PlantUML class diagram for configuration
	${UML_GENERATOR} $< --output puml --output-directory=docs/user_doc/
	mv docs/user_doc/classes.puml docs/user_doc/config.puml

# Omit --theme rose on the CLI: it fails with some plantuml.jar builds on pyreverse output.
# To use rose, add a line after @startuml: !theme rose  (requires a recent JAR).
# PNG is capped at 4096px per side by default; pyreverse class diagrams are often wider—raise the limit.
docs/user_doc/config.png:	docs/user_doc/config.puml ## Generate an image with configuration graph
	pushd docs/user_doc && \
	java -DPLANTUML_LIMIT_SIZE=16384 -jar ${PATH_TO_PLANTUML}/plantuml.jar config.puml && \
	mv classes.png config.png && \
	popd

docs/user_doc/config.svg:	docs/user_doc/config.puml ## Generate an SVG with configuration graph
	pushd docs/user_doc && \
	java -jar ${PATH_TO_PLANTUML}/plantuml.jar config.puml -tsvg && \
	xmllint --format classes.svg > config.svg && \
	rm -f classes.svg && \
	popd

