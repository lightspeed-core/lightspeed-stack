docs/models/requests.svg:	docs/models/requests.puml	## Generate an SVG with requests data models
	pushd docs/models && \
	java -jar ${PATH_TO_PLANTUML}/plantuml.jar requests.puml -tsvg && \
	xmllint --format classes.svg > requests.svg && \
	rm -f classes.svg && \
	popd

