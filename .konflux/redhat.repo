# Rolling (non-EUS) RHEL 9 repos at a lower priority (higher number) so that
# everything resolves from the pinned 9.6 EUS snapshot first, and these repos
# only supply packages that EUS 9.6 does not carry. Currently needed for
# cargo >= 1.85 to build Rust sdists that use edition2024 (e.g. nh3 >= 0.3.x).
# The repo ids below are the canonical (subscription-manager) ids with no
# suffix: the Enterprise Contract "rpm_repos.ids_known" policy only accepts
# repository ids from its known list, which has the canonical rolling ids
# (e.g. rhel-9-for-x86_64-appstream-rpms) and EUS ids with __9_DOT_X
# suffixes, but not custom suffixes like __ROLLING.
[rhel-9-for-$basearch-appstream-rpms]
name = Red Hat Enterprise Linux 9 for $basearch - AppStream (RPMs)
baseurl = https://cdn.redhat.com/content/dist/rhel9/9/$basearch/appstream/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslverify = 1
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslverifystatus = 1
metadata_expire = 86400
enabled_metadata = 0
priority = 50
sslclientkey = $SSL_CLIENT_KEY
sslclientcert = $SSL_CLIENT_CERT

[rhel-9-for-$basearch-baseos-rpms]
name = Red Hat Enterprise Linux 9 for $basearch - BaseOS (RPMs)
baseurl = https://cdn.redhat.com/content/dist/rhel9/9/$basearch/baseos/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslverify = 1
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslverifystatus = 1
metadata_expire = 86400
enabled_metadata = 0
priority = 50
sslclientkey = $SSL_CLIENT_KEY
sslclientcert = $SSL_CLIENT_CERT

