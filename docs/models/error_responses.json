            "DetailModel": {
                "description": "Nested detail model for error responses.",
                "properties": {
                    "response": {
                        "description": "Short summary of the error",
                        "title": "Response",
                        "type": "string"
                    },
                    "cause": {
                        "description": "Detailed explanation of what caused the error",
                        "title": "Cause",
                        "type": "string"
                    }
                },
                "required": [
                    "response",
                    "cause"
                ],
                "title": "DetailModel",
                "type": "object"
            },
