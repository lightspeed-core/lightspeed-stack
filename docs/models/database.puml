@startuml classes
set namespaceSeparator none
class "Base" as src.models.database.base.Base {
}
class "Prompt" as src.models.database.prompts.Prompt {
  created_at : Mapped[datetime]
  default_version : Mapped[int]
  id : Mapped[str]
